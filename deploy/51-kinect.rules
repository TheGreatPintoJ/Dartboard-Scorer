# The Kinect v1 is not a video4linux device: libfreenect drives it over raw USB,
# so access has to be granted on the USB nodes themselves.
#
# A dedicated group rather than plugdev, which is a desktop group carrying
# unrelated privileges, and not TAG+="uaccess", which only applies to logind
# seat sessions - a system service is not one.
SUBSYSTEM=="usb", ATTR{idVendor}=="045e", ATTR{idProduct}=="02ae", MODE="0660", GROUP="kinect"
SUBSYSTEM=="usb", ATTR{idVendor}=="045e", ATTR{idProduct}=="02ad", MODE="0660", GROUP="kinect"
SUBSYSTEM=="usb", ATTR{idVendor}=="045e", ATTR{idProduct}=="02c2", MODE="0660", GROUP="kinect"
SUBSYSTEM=="usb", ATTR{idVendor}=="045e", ATTR{idProduct}=="02b0", MODE="0660", GROUP="kinect"
